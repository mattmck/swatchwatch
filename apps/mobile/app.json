{
  "expo": {
    "name": "SwatchWatch",
    "slug": "swatchwatch",
    "scheme": "swatchwatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0a090e"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.swatchwatch.mobile"
    },
    "android": {
      "package": "app.swatchwatch.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SwatchWatch uses the camera to scan polish barcodes and labels for Rapid Add.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SwatchWatch reads a photo you pick to match its colors to your collection.",
          "cameraPermission": "SwatchWatch uses the camera to photograph a look to match against your collection."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
