# SwatchWatch mobile (Expo). Copy to .env.local (gitignored) and adjust.
# Only EXPO_PUBLIC_* variables reach the app; they are inlined at bundle time, so never put
# secrets here. Restart `npm run dev:mobile` after changing them.

# Functions API base URL. On the Android emulator "localhost" is rewritten to 10.0.2.2;
# on a physical device use your computer's LAN address (e.g. http://192.168.1.20:7071/api).
EXPO_PUBLIC_API_URL=http://localhost:7071/api

# Dev bypass: sends `Authorization: Bearer dev:<userId>` like the web. Needs the local
# Functions host with AUTH_DEV_BYPASS=true. Unset = on in development builds when sign-in
# below is not configured; "false" = off.
EXPO_PUBLIC_AUTH_DEV_BYPASS=true
EXPO_PUBLIC_AUTH_DEV_USER_ID=1

# Sign-in against the same Entra External ID tenant as the web (NEXT_PUBLIC_B2C_* there).
# Leave empty for dev bypass. See apps/mobile/README.md for the redirect URI to register.
EXPO_PUBLIC_B2C_TENANT=
EXPO_PUBLIC_B2C_TENANT_ID=
EXPO_PUBLIC_B2C_CLIENT_ID=
EXPO_PUBLIC_B2C_SIGNUP_SIGNIN_POLICY=
# Optional; defaults to api://<client-id>/access_as_user (space-separated list allowed).
EXPO_PUBLIC_B2C_API_SCOPE=
