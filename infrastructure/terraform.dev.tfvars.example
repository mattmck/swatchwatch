# Copy to terraform.dev.tfvars and fill in sensitive values.
subscription_id         = "your-azure-subscription-id"
environment             = "dev"
location                = "centralus"
github_repository       = "your-github-username/swatchwatch"
pg_admin_username       = "pgadmin"
pg_admin_password       = "<set-a-secure-password>"
create_openai_resources = true
openai_regions          = ["centralus"]
# Multi-region example: ["centralus", "southcentralus", "eastus", "eastus2"]
apim_enabled            = true
apim_sku_name           = "Consumption_0"
openai_gateway_enabled  = false
openai_batch_deployment_name = "hex-detector-batch"

# Optional batch-hex detection toggles
# hex_detection_batch_enabled      = true
# hex_detection_batch_min_images   = 5
# ingestion_ai_batch_poll_schedule = "0 */2 * * * *"
# ingestion_ai_batch_max_poll_jobs = 10

# Optional: manage the web sign-in app's service principal in the External ID
# tenant (app_role_assignment_required = false). See README "External ID
# service principal" for the one-time bootstrap. Leave ciam_terraform_client_id
# empty locally to use `az login --tenant <ciam tenant> --allow-no-subscriptions`.
# manage_ciam_service_principal = true
# ciam_tenant_id                = "2bff1c8d-f022-45ed-91bf-7485529ba989"
