{
  "permissions": {
    "allow": [
      "Bash(terraform validate:*)",
      "Bash(az account:*)",
      "Bash(az ad:*)",
      "Bash(az keyvault:*)",
      "Bash(terraform import:*)",
      "Bash(terraform init:*)",
      "Bash(az group:*)",
      "Bash(az resource:*)",
      "Bash(az storage:*)",
      "Bash(az redis:*)",
      "Bash(az redisenterprise:*)",
      "Bash(terraform state:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-files.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rebuild-shared.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
