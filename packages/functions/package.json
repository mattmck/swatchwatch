{
  "name": "swatchwatch-functions",
  "version": "0.1.0",
  "description": "Azure Functions for SwatchWatch",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:deploy": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-bundle/index.js --external:@azure/functions --external:@azure/storage-queue --external:applicationinsights --external:jose --external:p-limit --external:pg --external:redis --external:sharp",
    "pretest": "npm run build --workspace=swatchwatch-shared && npm run build",
    "test": "node --test tests/*.unit.test.cjs",
    "test:e2e": "node --test tests/api.test.cjs tests/access-control.e2e.test.cjs",
    "eval:hex": "npm run build --workspace=swatchwatch-shared && npm run build && node dist/eval/hex/cli.js",
    "eval:hex:populate": "npm run build --workspace=swatchwatch-shared && npm run build && node dist/eval/hex/populate.js",
    "backfill:image-variants": "node scripts/backfill-image-variants.cjs",
    "dedupe:gallery-images": "node scripts/dedupe-gallery-images.cjs",
    "backfill:barcodes": "node scripts/backfill-barcodes.cjs",
    "backfill:product-text": "npm run build --workspace=swatchwatch-shared && npm run build && node dist/scripts/backfill-product-text.js",
    "pack": "func pack --output ./dist/functions.zip --skip-install",
    "start": "func start",
    "watch": "tsc -w",
    "migrate": "node -e \"try{const s=require('./local.settings.json');Object.entries(s.Values).forEach(([k,v])=>process.env[k]=v)}catch{} const {execSync}=require('child_process');execSync('node scripts/forget-renamed-migrations.cjs',{stdio:'inherit'});execSync('node-pg-migrate up --migrations-dir migrations --decamelize',{stdio:'inherit'})\"",
    "migrate:down": "node -e \"try{const s=require('./local.settings.json');Object.entries(s.Values).forEach(([k,v])=>process.env[k]=v)}catch{} require('child_process').execSync('node-pg-migrate down --migrations-dir migrations --decamelize',{stdio:'inherit'})\"",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-filename-format utc --migration-file-language sql"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/storage-queue": "^12.17.0",
    "applicationinsights": "^3.16.0",
    "jose": "^6.1.3",
    "p-limit": "^3.1.0",
    "pg": "^8.18.0",
    "redis": "^5.11.0",
    "sharp": "^0.35.5",
    "swatchwatch-shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.16.0",
    "azure-functions-core-tools": "^4.6.0",
    "esbuild": "^0.28.2",
    "node-pg-migrate": "^8.0.4",
    "typescript": "^5.3.0"
  }
}
